{
  "name": "plan-visualizer",
  "version": "2.4.1",
  "description": "Self-contained project dashboard for Claude Code projects",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "generate": "node tools/generate-plan.js",
    "generate:watch": "node tools/generate-plan.js --watch",
    "dashboard": "node tools/generate-dashboard.js",
    "init:status": "node tools/init-sdlc-status.js",
    "build": "npm run generate && npm run init:status && npm run dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cleanup:branches": "bash scripts/cleanup-branches.sh",
    "cleanup:branches:dry": "bash scripts/cleanup-branches.sh --dry-run",
    "prepare": "husky",
    "migrate-config": "node tools/migrate-config.js",
    "migrate-config:dry": "node tools/migrate-config.js --dry-run",
    "memory:compact": "node tools/memory.js compact",
    "memory:archive": "node tools/memory.js archive",
    "memory:archive:dry": "node tools/memory.js archive --dry",
    "memory:migrate": "node tools/memory.js migrate",
    "memory:migrate-commit": "node tools/memory.js migrate-commit",
    "memory:suggest-model": "node tools/memory.js suggest-model",
    "memory:validate": "node tools/memory.js validate",
    "agent:approve": "node tools/agent-spec-plan.js approve",
    "agent:reject": "node tools/agent-spec-plan.js reject",
    "agent:pending": "node tools/agent-spec-plan.js show-pending",
    "agent:apply": "node tools/agent-spec-plan.js apply-pending",
    "agent:list": "node tools/agent-spec-plan.js list",
    "agent:status": "node tools/agent-spec-plan.js status",
    "dashboard:watch": "node tools/watch-dashboard.js"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml}": "prettier --write",
    "*.js": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "chart.js": "^4.5.1",
    "eslint": "10.2.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
